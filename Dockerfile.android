# syntax=docker/dockerfile:1.7
FROM node:22-bookworm@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS builder

ARG ANDROID_CMDLINE_TOOLS=11076708
ARG ANDROID_API=36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_COMPAT_BUILD_TOOLS=35.0.0
ARG ANDROID_NDK=27.1.12297006
ARG ANDROID_CMAKE=3.22.1
ARG VULKAN_HEADERS=1.4.350.0

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    VULKAN_SDK=/opt/vulkan-sdk \
    GRADLE_USER_HOME=/root/.gradle \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        glslc \
        libvulkan-dev \
        ninja-build \
        openjdk-17-jdk-headless \
        python3 \
        spirv-headers \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "${ANDROID_HOME}/cmdline-tools" /opt/vulkan-sdk/Include \
    && curl -fsSL "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-${VULKAN_HEADERS}.tar.gz" -o /tmp/vulkan-headers.tar.gz \
    && tar -xzf /tmp/vulkan-headers.tar.gz -C /tmp \
    && cp -R "/tmp/Vulkan-Headers-vulkan-sdk-${VULKAN_HEADERS}/include/vulkan" /opt/vulkan-sdk/Include/vulkan \
    && cp -R "/tmp/Vulkan-Headers-vulkan-sdk-${VULKAN_HEADERS}/include/vk_video" /opt/vulkan-sdk/Include/vk_video \
    && ln -s /usr/include/spirv /opt/vulkan-sdk/Include/spirv \
    && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" -o /tmp/android-tools.zip \
    && unzip -q /tmp/android-tools.zip -d /tmp/android-tools \
    && mv /tmp/android-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -rf /tmp/android-tools /tmp/android-tools.zip /tmp/vulkan-headers.tar.gz "/tmp/Vulkan-Headers-vulkan-sdk-${VULKAN_HEADERS}" \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager \
        "platform-tools" \
        "platforms;android-${ANDROID_API}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" \
        "build-tools;${ANDROID_COMPAT_BUILD_TOOLS}" \
        "ndk;${ANDROID_NDK}" \
        "cmake;${ANDROID_CMAKE}"

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,target=/root/.npm \
    npm ci \
    && npm --prefix stable-diffusion ci \
    && npm --prefix stable-diffusion run build

RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=cache,target=/workspace/android/.gradle \
    chmod +x android/gradlew \
    && cd android \
    && CMAKE_BUILD_PARALLEL_LEVEL=2 NODE_ENV=production ./gradlew :app:assembleRelease \
        -PreactNativeArchitectures=arm64-v8a \
        --max-workers=2 \
        --no-parallel \
        --no-daemon \
        --stacktrace

FROM scratch AS artifact
COPY --from=builder /workspace/android/app/build/outputs/apk/release/app-release.apk /pocket-canvas-release.apk
